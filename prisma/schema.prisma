generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}


model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  moodEntries    MoodEntry[]
  diaryEntries   DiaryEntry[]
  communityPosts CommunityPost[]
  postHearts     PostHeart[]
}

enum MoodLevel {
  ATOPE          // 5 - Excelente
  BIEN            // 4 - Bien
  REGULAR         // 3 - Más o menos
  MAL             // 2 - Mal
  BURNOUT   // 1 - Burnout
}

enum MoodTag {
  EXAMENES
  FALTA_DE_SUENO
  PROBLEMAS_PERSONALES
  CARGA_DE_TAREAS
}

model MoodEntry {
  id        String     @id @default(cuid())
  level     MoodLevel
  tags      MoodTag[]
  note      String?    // Nota opcional junto al registro de ánimo
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([createdAt])
}

model DiaryEntry {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model DailyPhrase {
  id        String   @id @default(cuid())
  text      String
  author    String?
  createdAt DateTime @default(now())
}

model CommunityRoom {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  posts       CommunityPost[]
  createdAt   DateTime        @default(now())
}

model CommunityPost {
  id          String        @id @default(cuid())
  content     String
  isAnonymous Boolean       @default(false)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  roomId      String
  room        CommunityRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  hearts      PostHeart[]
  createdAt   DateTime      @default(now())

  @@index([roomId])
  @@index([userId])
}

model PostHeart {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId]) // Un usuario solo puede dar un corazón por post
}
